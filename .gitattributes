# Auto-detect text files and normalize line endings
* text=auto

# Force LF for shell scripts (cross-platform compatibility)
*.sh text eol=lf
*.bash text eol=lf

# Force CRLF for Windows-specific scripts
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Force LF for web and config files
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.xml text eol=lf

# Force LF for documentation
*.md text eol=lf
*.txt text eol=lf

# Force LF for Python
*.py text eol=lf

# Force LF for Docker and CI
Dockerfile text eol=lf
docker-compose*.yml text eol=lf
.dockerignore text eol=lf
Makefile text eol=lf

# Binary files - do not modify
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.7z binary
*.exe binary
*.dll binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Git-specific
.gitignore text eol=lf
.gitattributes text eol=lf
