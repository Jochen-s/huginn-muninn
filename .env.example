# Huginn & Muninn -- Environment Configuration
# Copy to .env and adjust values for your deployment.

# Ollama connection -- point to your Ollama instance
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Default LLM model
HUGINN_DEFAULT_MODEL=qwen3.5:9b

# CORS origins (comma-separated). Default is localhost-only; "*" allows any site to call the API.
HUGINN_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Storage and limits ---
# SQLite database path (default: ~/.huginn/huginn.db; docker-compose sets /data/huginn.db)
# HUGINN_DB_PATH=/data/huginn.db
# Maximum queued jobs kept in memory (default 1000)
# HUGINN_MAX_JOBS=1000
# Maximum claims per batch request (default 50)
# HUGINN_MAX_BATCH_SIZE=50
# Multi-model comparison registry (default: ~/.huginn/models.json)
# HUGINN_MODELS_CONFIG=/data/models.json

# --- Optional egress (each sends data off the machine; off unless set) ---
# LLM provider: ollama (default, local) or a hosted provider name from model_registry
# HUGINN_LLM_PROVIDER=ollama
# API key for a hosted LLM provider (never needed for ollama)
# HUGINN_LLM_API_KEY=
# Web search: setting a key enables outbound search queries (provider default: brave)
# HUGINN_SEARCH_API_KEY=
# HUGINN_SEARCH_PROVIDER=brave

# --- Webhooks and output policy ---
# Optional fixed HMAC secret for outbound webhook signatures (per-webhook secrets are generated otherwise)
# HUGINN_WEBHOOK_SECRET=
# Comma-separated Bridge diagnostic fields to suppress at every external boundary
# HUGINN_SUPPRESS_FIELDS=
